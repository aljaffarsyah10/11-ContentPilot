# Environment Configuration Template
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contentpilot?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-a-32-byte-secret-with-openssl-rand-hex-32"
AUTH_URL="http://localhost:3000"

# AI Provider (OpenAI)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

